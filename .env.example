# PixSort Environment Variables

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Web App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# --- AI Service (FastAPI + InsightFace) ---
AI_HOST=0.0.0.0
AI_PORT=8000
AI_MODEL_NAME=buffalo_l
AI_DETECTION_THRESHOLD=0.6
AI_SIMILARITY_THRESHOLD=0.45
AI_CLUSTERING_THRESHOLD=0.50
AI_PHASH_DUP_THRESHOLD=8

# --- Worker Tuning ---
AI_WORKER_POLL_INTERVAL=3.0
AI_WORKER_BATCH_SIZE=10
AI_WORKER_MAX_RETRIES=3
